# ── Google Maps ──────────────────────────────────────────────────────────────
# API key for map stream type rendering.
# Get one at https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_key_here

# ── CLI templates (config.mjs) ──────────────────────────────────────────────
# All use MARKCUT_*_CLI env vars. Supports {input}, {prompt}, {output}.
# Shared by vision and render pipelines:
# MARKCUT_ITT_CLI=    # Image-to-text CLI (default: mlx-vlm)
# MARKCUT_VTT_CLI=    # Video-to-text CLI (default: mlx-vlm video mode)
# MARKCUT_STT_CLI=    # Speech-to-text CLI (default: whisper via uvx)
# MARKCUT_TTS_CLI=    # Text-to-speech CLI (default: edge-tts)
# MARKCUT_AGENT_CLI=  # General-purpose agent CLI (default: npx pi)
# Render-only:
# MARKCUT_TTI_CLI=    # Text-to-image CLI (default: mflux)
# MARKCUT_TTV_CLI=    # Text-to-video CLI (default: empty → TTI + ffmpeg)
# Other:
# MARKCUT_MAX_IMAGE_DIMENSION=384
# MARKCUT_MAX_VIDEO_DURATION=60
# MARKCUT_MAX_VIDEO_DIMENSION=360
# MARKCUT_VTT_SAMPLE_INTERVAL=5
# The CLI template uses {input} (audio path) and {output} (output directory).
