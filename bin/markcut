#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
const root = resolve(__dirname, "..");
if (process.argv[2] === "preview" && process.argv.includes("--delivery")) {
  const index=process.argv.indexOf("--delivery");
  if (process.argv[index+1] !== "event") {
    console.error("CLI review delivery supports only --delivery event; omit --delivery for the native preview.");
    process.exit(1);
  }
  const entry=resolve(root,"src","mcp","mobile-review-cli.mjs");
  const result=spawnSync(process.execPath,[entry,...process.argv.slice(2)],{stdio:"inherit"});
  if(result.error)console.error(result.error.message);
  process.exit(result.status??1);
}
if (process.argv[2] === "queue") {
  const result = spawnSync(process.execPath, [resolve(root, "src", "queue-worker.mjs"), ...process.argv.slice(3)], { stdio: "inherit" });
  if (result.error) console.error(result.error.message);
  process.exit(result.status ?? 1);
}
const entry = resolve(root, "src", "render", "cli.mjs");

const result = spawnSync(process.execPath, [entry, ...process.argv.slice(2)], {
  stdio: "inherit",
});

if (result.error) {
  console.error(result.error.message);
  process.exit(1);
}

process.exit(result.status ?? 1);
