{
  "tts": "uvx edge-tts --voice \"zh-CN-YunxiNeural\" --text \"{input}\" --write-media \"{output}\"",
  "stt": "uvx --from openai-whisper whisper \"{input}\" --model tiny --device cpu --fp16 False --threads 2 --output_format vtt --output_dir \"{output}\" --word_timestamps True --max_line_count 1 --max_line_width 14",
  "itt": "MARKCUT_VISION_DISABLE_LOCAL=1 node {markcut_root}/src/vision/default-infer.mjs --prompt \"{prompt}\" {input}",
  "vtt": "",
  "tti": "ffmpeg -hide_banner -loglevel error -y -f lavfi -i smptebars=size=512x512 -frames:v 1 -threads 1 \"{output}\"",
  "ttv": "",
  "agent": "npx pi -p {prompt}",
  "editCli": "npx pi --session-id {sessionid} --system-prompt {systemprompt} -p {prompt}"
}
