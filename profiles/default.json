{
  "tts": "uvx edge-tts --voice \"zh-CN-YunxiNeural\" --text \"{input}\" --write-media \"{output}\"",
  "stt": "uvx --from openai-whisper whisper \"{input}\" --output_format vtt --output_dir \"{output}\" --word_timestamps True --max_line_count 1 --max_line_width 14",
  "itt": "node {markcut_root}/src/vision/default-infer.mjs --prompt \"{prompt}\" {input}",
  "vtt": "",
  "tti": "uvx --from mflux mflux-generate-flux2 --model flux2-klein-4b --steps 2 --prompt \"{input}\" --output \"{output}\" --seed {seed}",
  "ttv": "",
  "agent": "npx pi -p {prompt}",
  "editCli": "npx pi --session-id {sessionid} --system-prompt {systemprompt} -p {prompt}"
}
