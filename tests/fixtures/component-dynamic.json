{
  "id": "root",
  "type": "root",
  "width": 640,
  "height": 480,
  "fps": 30,
  "isSeries": true,
  "transition": "fade",
  "transitionTime": 0.3,
  "children": [
    {
      "id": "jsx-scene",
      "type": "folder",
      "isSeries": false,
      "children": [
        {
          "id": "jsx-comp",
          "type": "component",
          "jsx": "<Counter value={42} suffix='%' label='Score' />",
          "imports": {
            "Counter": "https://esm.sh/counter-component"
          },
          "actions": [{ "start": 0, "end": 2 }]
        }
      ]
    },
    {
      "id": "remote-src",
      "type": "folder",
      "isSeries": false,
      "children": [
        {
          "id": "remote-comp",
          "type": "component",
          "jsx": "<Badge label='Remote' />",
          "imports": {
            "Badge": "https://esm.sh/gh/user/remotion-component-example"
          },
          "actions": [{ "start": 0, "end": 2 }]
        }
      ]
    }
  ]
}
