{
  "id": "root",
  "type": "root",
  "width": 640,
  "height": 480,
  "fps": 30,
  "isSeries": true,
  "transition": "fade",
  "transitionTime": 0.3,
  "children": [
    {
      "id": "mode-jsx",
      "type": "scene",
      "name": "JSX Usage",
      "children": [
        {
          "id": "c-counter",
          "type": "component",
          "jsx": "<Counter value={99} suffix='%' label='Score' />",
          "imports": {
            "Counter": "https://esm.sh/counter-component",
            "Badge": "https://esm.sh/badge-component"
          },
          "actions": [{ "start": 0, "end": 2 }]
        }
      ]
    },
    {
      "id": "mode-svg",
      "type": "scene",
      "name": "Inline SVG",
      "children": [
        {
          "id": "c-svg",
          "type": "component",
          "jsx": "<svg viewBox='0 0 100 100' style={{width:'100%',height:'100%'}}><circle cx={50} cy={50} r={40} fill='#667eea' /></svg>",
          "actions": [{ "start": 0, "end": 2 }]
        }
      ]
    }
  ]
}
